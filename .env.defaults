# Storage configuration
STORAGE_DIR=/app/server/storage

# JWT Secret for AnythingLLM Authentication
JWT_SECRET=your-secret-here

# LLM Provider Configuration
LLM_PROVIDER=litellm
LLM_URL=https://<llm-region>.amazee.ai
LLM_AI_KEY=your-key-here
LITE_LLM_MODEL_PREF=chat
LITE_LLM_MODEL_TOKEN_LIMIT=8192

# Embedding Provider
EMBEDDING_ENGINE=litellm
EMBEDDING_MODEL_PREF=embeddings
EMBEDDING_MODEL_MAX_CHUNK_LENGTH=8192

# Database Configuration (External DB support)
DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=
DB_PORT=5432

# Disable telemetry
DISABLE_TELEMETRY=true
